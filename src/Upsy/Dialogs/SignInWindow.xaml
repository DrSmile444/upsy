<local:DialogWindow x:Class="Upsy.Dialogs.SignInWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Upsy.Dialogs"
                    Title="Sign in to EcoFlow" Width="432"
                    AutomationProperties.Name="Sign in to EcoFlow">
  <Window.Resources>
    <ResourceDictionary Source="/upsy;component/Flyout/FlyoutStyles.xaml" />
  </Window.Resources>
  <!-- design/upsy.design.html #signin -->
  <Border Margin="16" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Flyout}" BorderBrush="{DynamicResource FlyoutStroke}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.22" />
    </Border.Effect>
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Height="32" Background="Transparent" MouseDown="OnTitleBarMouseDown">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="46" FontSize="10" Content="&#xE8BB;" Click="OnCloseButton"
                IsCancel="True" AutomationProperties.Name="Close" />
        <Image Source="/upsy;component/Assets/upsy-256.png" Width="16" Height="16" Margin="12,0,8,0" />
        <TextBlock Text="upsy" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
      </DockPanel>
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource FooterTint}"
              CornerRadius="0,0,8,8" Padding="24,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource DialogButton}" Content="Cancel" Click="OnCloseButton" Margin="0,0,8,0" />
          <Button x:Name="SignInButton" Style="{StaticResource DialogAccentButton}" Content="Sign in" IsDefault="True" Click="OnSignIn" />
        </StackPanel>
      </Border>
      <StackPanel Margin="24,12,24,20">
        <TextBlock Text="Sign in to EcoFlow" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" Margin="0,0,0,6" />
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource Ink2}" Margin="0,0,0,16" />
        <Border x:Name="ErrorBar" Padding="12,10" CornerRadius="4" BorderThickness="1" Margin="0,0,0,12" Visibility="Collapsed"
                Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}">
          <DockPanel>
            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA39;" FontSize="16" Foreground="{DynamicResource Critical}" Margin="0,0,8,0" />
            <StackPanel>
              <TextBlock Text="EcoFlow did not accept the sign-in" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Ink}" />
              <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Ink}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock Text="Email" Foreground="{DynamicResource Ink}" Margin="0,0,0,6" />
        <TextBox x:Name="EmailBox" Margin="0,0,0,12" AutomationProperties.Name="Email" />
        <TextBlock Text="Password" Foreground="{DynamicResource Ink}" Margin="0,0,0,6" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password" />
      </StackPanel>
    </DockPanel>
  </Border>
</local:DialogWindow>
