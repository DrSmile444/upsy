<local:DialogWindow x:Class="Upsy.Dialogs.AddStationWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Upsy.Dialogs"
                    Title="Add a station" Width="432"
                    AutomationProperties.Name="Add a station">
  <Window.Resources>
    <ResourceDictionary Source="/upsy;component/Flyout/FlyoutStyles.xaml" />
  </Window.Resources>
  <!-- design/upsy.design.html #add-station -->
  <Border Margin="16" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Flyout}" BorderBrush="{DynamicResource FlyoutStroke}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.22" />
    </Border.Effect>
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Height="32" Background="Transparent" MouseDown="OnTitleBarMouseDown">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="46" FontSize="10" Content="&#xE8BB;" Click="OnCloseButton"
                AutomationProperties.Name="Close" />
        <Image Source="/upsy;component/Assets/upsy-256.png" Width="16" Height="16" Margin="12,0,8,0" />
        <TextBlock Text="upsy" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
      </DockPanel>
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource FooterTint}"
              CornerRadius="0,0,8,8" Padding="24,16">
        <Button Style="{StaticResource DialogButton}" Content="Close" HorizontalAlignment="Right" IsCancel="True" Click="OnCloseButton" />
      </Border>
      <StackPanel Margin="24,12,24,20">
        <TextBlock Text="Add a station" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ink2}" Margin="0,0,0,16"
                   Text="Stations near this PC that upsy can read. Turn the station on and keep it within a few metres." />
        <Border CornerRadius="6" BorderThickness="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}">
          <StackPanel>
            <StackPanel x:Name="Rows" />
            <TextBlock x:Name="Empty" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource Ink2}" Margin="12,20"
                       Text="Looking for stations…&#x0a;&#x0a;upsy reads the Bluetti EB3A and the EcoFlow DELTA 2. Close the phone app if it is connected to the station." />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</local:DialogWindow>
