<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows 11 menu, per DESIGN.md "Context menu": 8 px radius, 4 px padding, 32 px rows, Fluent icons. -->
  <FontFamily x:Key="MenuIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <ControlTemplate x:Key="MenuChrome" TargetType="ContentControl">
    <Border Margin="12" CornerRadius="8" BorderThickness="1" Padding="4"
            Background="{DynamicResource Flyout}" BorderBrush="{DynamicResource FlyoutStroke}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.22" />
      </Border.Effect>
      <ContentPresenter />
    </Border>
  </ControlTemplate>

  <Style x:Key="UpsyContextMenu" TargetType="ContextMenu">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="MinWidth" Value="272" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <ContentControl Template="{StaticResource MenuChrome}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Margin="-4,4" Fill="{DynamicResource Divider}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tag carries the item's Fluent glyph; a checked item shows a check mark in the same column. -->
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bg" Height="32" CornerRadius="4" Background="Transparent" Padding="10,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Glyph" Width="28" Text="{TemplateBinding Tag}" FontFamily="{StaticResource MenuIcons}" FontSize="14"
                         VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="12" Margin="16,0,0,0"
                         Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
              <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource MenuIcons}" FontSize="10"
                         Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <Popup x:Name="PART_Popup" Grid.Column="3" Placement="Right" HorizontalOffset="-8" VerticalOffset="-17"
                     IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <ContentControl Template="{StaticResource MenuChrome}" MinWidth="136">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </ContentControl>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
              <Setter Property="FontSize" Value="12" />
              <Setter TargetName="Bg" Property="Height" Value="28" />
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
