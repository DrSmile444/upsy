<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the flyout, the station sections and upsy's small windows. Colours are the DESIGN.md tokens, set as dynamic resources by Palette.Apply. -->
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontFamily" Value="{StaticResource Icons}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="4" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,10,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" CornerRadius="6" Margin="-3" BorderThickness="2" BorderBrush="Transparent" />
            <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ExpanderHeader" TargetType="ToggleButton">
    <Setter Property="Height" Value="40" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="10,0">
            <DockPanel>
              <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="{StaticResource Icons}" FontSize="12" Text="&#xE70D;"
                         Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="DialogAccentButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <!-- Windows 11 text field: card fill, 1 px stroke, an underline that turns accent and 2 px on focus. -->
  <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
    <Grid>
      <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource Card}" />
      <Border x:Name="Underline" CornerRadius="0,0,4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Ink2}" />
      <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" Focusable="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
        <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Accent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Box" Property="Opacity" Value="0.6" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="TextBox">
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
  </Style>
</ResourceDictionary>
