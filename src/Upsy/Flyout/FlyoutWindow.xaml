<Window x:Class="Upsy.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="upsy" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AutomationProperties.Name="upsy">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtlePressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" CornerRadius="6" Margin="-3" BorderThickness="2" BorderBrush="Transparent" />
              <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ExpanderHeader" TargetType="ToggleButton">
      <Setter Property="Height" Value="40" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="10,0">
              <DockPanel>
                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="{StaticResource Icons}" FontSize="12" Text="&#xE70D;"
                           Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
                <ContentPresenter VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Margin="16" CornerRadius="8" BorderThickness="1"
          Background="{DynamicResource Flyout}" BorderBrush="{DynamicResource FlyoutStroke}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.22" />
    </Border.Effect>
    <DockPanel>
      <!-- Footer -->
      <Border DockPanel.Dock="Bottom" Height="48" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource FooterTint}" CornerRadius="0,0,8,8">
        <DockPanel Margin="16,0,8,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" Click="OnPauseButton" />
            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="OnMoreButton"
                    AutomationProperties.Name="More options" ToolTip="More options" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/upsy;component/Assets/upsy-256.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="upsy" FontSize="12" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel>
      <!-- Header: glyph + percentage + state -->
      <Grid Margin="16,16,16,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- station-glyph:begin (generated by tools/gen_station_glyph.py) -->
        <Viewbox x:Name="GlyphBox" Width="104" Height="96" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Station">
          <Canvas x:Name="Glyph" Width="800" Height="740">
            <Rectangle x:Name="GAcPad" Canvas.Left="434" Canvas.Top="500" Width="270" Height="163" RadiusX="16" RadiusY="16" />
            <Rectangle x:Name="GDcPad" Canvas.Left="91" Canvas.Top="274" Width="155" Height="207" RadiusX="15" RadiusY="15" />
            <Path Data="M111 139H61Q47 139 40 155L16 205Q8 220 8 247V686Q8 718 40 718H759Q790 718 790 685V247Q790 220 781 205L758 154Q750 139 735 139H686" StrokeThickness="18" />
            <Path Data="M112 164V62Q112 10 166 10H632Q687 10 687 62V164H643V76Q643 54 618 54H180Q156 54 156 77V164Z" StrokeThickness="18" />
            <Rectangle Canvas.Left="47" Canvas.Top="245" Width="706" Height="439" RadiusX="35" RadiusY="35" StrokeThickness="13" />
            <Rectangle Canvas.Left="265" Canvas.Top="272" Width="270" Height="148" RadiusX="19" RadiusY="19" StrokeThickness="13" />
            <Rectangle Canvas.Left="98" Canvas.Top="500" Width="299" Height="163" RadiusX="16" RadiusY="16" StrokeThickness="10" />
            <Ellipse Canvas.Left="120" Canvas.Top="563" Width="36" Height="36" StrokeThickness="10" />
            <Canvas x:Name="GDcOut">
              <Rectangle Canvas.Left="91" Canvas.Top="274" Width="155" Height="207" RadiusX="15" RadiusY="15" StrokeThickness="10" />
              <Ellipse Canvas.Left="117" Canvas.Top="310" Width="104" Height="104" StrokeThickness="13" />
              <Ellipse Canvas.Left="143" Canvas.Top="336" Width="52" Height="52" StrokeThickness="10" />
              <Ellipse Canvas.Left="122" Canvas.Top="439" Width="22" Height="22" StrokeThickness="10" />
              <Ellipse Canvas.Left="197" Canvas.Top="439" Width="22" Height="22" StrokeThickness="10" />
              <Rectangle Canvas.Left="290" Canvas.Top="436" Width="39" Height="15" RadiusX="3" RadiusY="3" StrokeThickness="10" />
              <Rectangle Canvas.Left="381" Canvas.Top="436" Width="39" Height="15" RadiusX="3" RadiusY="3" StrokeThickness="10" />
              <Rectangle Canvas.Left="474" Canvas.Top="438" Width="28" Height="11" RadiusX="5" RadiusY="5" StrokeThickness="10" />
            </Canvas>
            <Canvas x:Name="GLight">
              <Rectangle Canvas.Left="562" Canvas.Top="274" Width="145" Height="155" RadiusX="14" RadiusY="14" StrokeThickness="10" />
              <Ellipse Canvas.Left="594" Canvas.Top="300" Width="80" Height="80" StrokeThickness="13" />
              <Ellipse Canvas.Left="618" Canvas.Top="324" Width="32" Height="32" StrokeThickness="10" />
            </Canvas>
            <Canvas x:Name="GAcIn">
              <Rectangle Canvas.Left="186" Canvas.Top="539" Width="99" Height="88" RadiusX="12" RadiusY="12" StrokeThickness="13" />
            </Canvas>
            <Canvas x:Name="GDcIn">
              <Ellipse Canvas.Left="299" Canvas.Top="548" Width="76" Height="76" StrokeThickness="13" />
              <Ellipse Canvas.Left="320" Canvas.Top="569" Width="34" Height="34" StrokeThickness="10" />
            </Canvas>
            <Canvas x:Name="GAcOut">
              <Rectangle Canvas.Left="434" Canvas.Top="500" Width="270" Height="163" RadiusX="16" RadiusY="16" StrokeThickness="10" />
              <Ellipse Canvas.Left="524" Canvas.Top="522" Width="120" Height="120" StrokeThickness="13" />
              <Ellipse Tag="dot" Canvas.Left="546" Canvas.Top="570" Width="20" Height="20" />
              <Ellipse Tag="dot" Canvas.Left="602" Canvas.Top="570" Width="20" Height="20" />
              <Rectangle Canvas.Left="453" Canvas.Top="559" Width="23" Height="49" RadiusX="11" RadiusY="11" StrokeThickness="10" />
            </Canvas>
            <Path x:Name="GGaugeTrack" Data="M328 392 A72 72 0 0 1 472 392" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="GGaugeValue" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Canvas>
        </Viewbox>
        <!-- station-glyph:end -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="SourceText" FontSize="12" Foreground="{DynamicResource Ink2}" />
          <TextBlock x:Name="PercentText" Foreground="{DynamicResource Ink}" Margin="0,0,0,2"
                     FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold">
            <Run x:Name="PercentValue" FontSize="40" /><Run Text="%" FontSize="20" />
          </TextBlock>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusLine" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="200" />
          </StackPanel>
          <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>

      <!-- In / Out strip -->
      <Border x:Name="Flows" Margin="16,0,16,12" CornerRadius="6" BorderThickness="1"
              Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="1" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="12,8">
            <TextBlock Text="In" FontSize="12" Foreground="{DynamicResource Ink2}" />
            <TextBlock x:Name="InText" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
          </StackPanel>
          <Rectangle Grid.Column="1" Fill="{DynamicResource Divider}" />
          <StackPanel Grid.Column="2" Margin="12,8">
            <TextBlock Text="Out" FontSize="12" Foreground="{DynamicResource Ink2}" />
            <TextBlock x:Name="OutText" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- No-data notice -->
      <Border x:Name="Notice" Margin="16,0,16,12" Padding="12,10" CornerRadius="6" BorderThickness="1"
              Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}">
        <StackPanel>
          <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,2" TextWrapping="Wrap" />
          <TextBlock x:Name="NoticeBody" FontSize="12" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" />
          <Button x:Name="NoticeButton" Style="{StaticResource TextButton}" Click="OnNoticeButton" />
        </StackPanel>
      </Border>

      <!-- Details expander -->
      <Border x:Name="Details" Margin="16,0,16,12" CornerRadius="6" BorderThickness="1"
              Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}">
        <StackPanel>
          <ToggleButton x:Name="DetailsToggle" Style="{StaticResource ExpanderHeader}" Content="Details" Checked="OnDetailsToggled" Unchecked="OnDetailsToggled" />
          <Border x:Name="DetailsBody" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="12,4,12,10" Visibility="Collapsed">
            <Grid x:Name="DetailsGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
